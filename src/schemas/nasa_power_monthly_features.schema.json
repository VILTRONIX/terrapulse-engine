{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nasa_power_monthly_features",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "location_id",
    "latitude",
    "longitude",
    "year",
    "month",
    "month_start",
    "month_end",
    "days_expected",
    "days_present",
    "complete",
    "T2M_mean",
    "T2M_MAX_mean",
    "T2M_MIN_mean",
    "PRECTOTCORR_total",
    "PRECTOTCORR_daily_mean",
    "ALLSKY_SFC_SW_DWN_total",
    "ALLSKY_SFC_SW_DWN_daily_mean",
    "RH2M_mean"
  ],
  "properties": {
    "location_id": {
      "type": "string",
      "description": "Selected NASA POWER representative point identifier.",
      "x-unit": null,
      "enum": [
        "DG001",
        "DG002",
        "DG003",
        "DG004"
      ]
    },
    "latitude": {
      "type": "number",
      "description": "Source point latitude, north positive.",
      "x-unit": "degrees_north",
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": "number",
      "description": "Source point longitude, east positive.",
      "x-unit": "degrees_east",
      "minimum": -180,
      "maximum": 180
    },
    "year": {
      "type": "integer",
      "description": "Calendar year.",
      "x-unit": null,
      "minimum": 2017,
      "maximum": 2025
    },
    "month": {
      "type": "integer",
      "description": "Calendar month number.",
      "x-unit": null,
      "minimum": 1,
      "maximum": 12
    },
    "month_start": {
      "type": "string",
      "description": "First calendar date of the represented month.",
      "x-unit": null,
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "month_end": {
      "type": "string",
      "description": "Last calendar date of the represented month.",
      "x-unit": null,
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "days_expected": {
      "type": "integer",
      "description": "Calendar days expected in the month.",
      "x-unit": "days",
      "minimum": 28,
      "maximum": 31
    },
    "days_present": {
      "type": "integer",
      "description": "Source daily records present in the month.",
      "x-unit": "days",
      "minimum": 0,
      "maximum": 31
    },
    "complete": {
      "type": "boolean",
      "description": "True when days_present equals days_expected.",
      "x-unit": null
    },
    "T2M_mean": {
      "type": "number",
      "description": "Monthly arithmetic mean of daily 2 m temperature.",
      "x-unit": "C"
    },
    "T2M_MAX_mean": {
      "type": "number",
      "description": "Monthly arithmetic mean of daily maximum 2 m temperature.",
      "x-unit": "C"
    },
    "T2M_MIN_mean": {
      "type": "number",
      "description": "Monthly arithmetic mean of daily minimum 2 m temperature.",
      "x-unit": "C"
    },
    "PRECTOTCORR_total": {
      "type": "number",
      "description": "Sum of daily corrected precipitation amounts over the calendar month.",
      "x-unit": "mm",
      "minimum": 0
    },
    "PRECTOTCORR_daily_mean": {
      "type": "number",
      "description": "Arithmetic mean of daily corrected precipitation.",
      "x-unit": "mm/day",
      "minimum": 0
    },
    "ALLSKY_SFC_SW_DWN_total": {
      "type": "number",
      "description": "Sum of daily all-sky surface shortwave irradiation over the month.",
      "x-unit": "MJ/m^2",
      "minimum": 0
    },
    "ALLSKY_SFC_SW_DWN_daily_mean": {
      "type": "number",
      "description": "Arithmetic mean of daily all-sky surface shortwave irradiation.",
      "x-unit": "MJ/m^2/day",
      "minimum": 0
    },
    "RH2M_mean": {
      "type": "number",
      "description": "Monthly arithmetic mean of daily relative humidity at 2 m.",
      "x-unit": "%",
      "minimum": 0,
      "maximum": 100
    }
  },
  "x-dataset": {
    "dataset_name": "nasa_power_monthly_features",
    "path": "data/processed/features/nasa_power_monthly_features.csv",
    "schema_path": "src/schemas/nasa_power_monthly_features.schema.json",
    "source_path": "data/processed/nasa_power/power_monthly_by_location.csv",
    "primary_key": [
      "location_id",
      "year",
      "month"
    ],
    "temporal_grain": "Calendar month at each representative point",
    "spatial_grain": "Four separate NASA POWER representative points; not a county average",
    "county_scope": {
      "name": "Story County, Iowa",
      "geoid": "19169"
    },
    "optional": false,
    "provenance": {
      "source_path": "data/processed/nasa_power/power_monthly_by_location.csv",
      "evidence_paths": [
        "data/processed/nasa_power/power_monthly_summary.md",
        "data/processed/nasa_power/power_daily_final_audit.md",
        "data/processed/nasa_power/power_selected_files.csv"
      ],
      "transformation": "Byte-for-byte copy of an existing validated CSV; no aggregation, imputation, conversion, or rounding."
    },
    "validation": {
      "expected_row_count": 432,
      "coverage": {
        "start": "2017-01",
        "end": "2025-12",
        "months_per_point": 108
      },
      "expected_missing_counts": {
        "location_id": 0,
        "latitude": 0,
        "longitude": 0,
        "year": 0,
        "month": 0,
        "month_start": 0,
        "month_end": 0,
        "days_expected": 0,
        "days_present": 0,
        "complete": 0,
        "T2M_mean": 0,
        "T2M_MAX_mean": 0,
        "T2M_MIN_mean": 0,
        "PRECTOTCORR_total": 0,
        "PRECTOTCORR_daily_mean": 0,
        "ALLSKY_SFC_SW_DWN_total": 0,
        "ALLSKY_SFC_SW_DWN_daily_mean": 0,
        "RH2M_mean": 0
      },
      "requirements": [
        "Exact ordered source columns and declared CSV types.",
        "Unique, non-null natural key within the declared spatial scope.",
        "Finite numeric values, declared ranges, exact coverage and missing counts.",
        "Source and output records identical, including order, precision and null markers.",
        "Source/output/schema SHA-256 values and manifest metadata agree.",
        "Dataset-specific calendar, denominator, quality and unit-consistency checks."
      ]
    },
    "warnings": [
      "Selected points remain separate; monthly features reuse existing audited daily aggregates. Daily data is retained in its original location."
    ]
  },
  "x-csv": {
    "encoding": "utf-8",
    "delimiter": ",",
    "ordered_columns": [
      "location_id",
      "latitude",
      "longitude",
      "year",
      "month",
      "month_start",
      "month_end",
      "days_expected",
      "days_present",
      "complete",
      "T2M_mean",
      "T2M_MAX_mean",
      "T2M_MIN_mean",
      "PRECTOTCORR_total",
      "PRECTOTCORR_daily_mean",
      "ALLSKY_SFC_SW_DWN_total",
      "ALLSKY_SFC_SW_DWN_daily_mean",
      "RH2M_mean"
    ],
    "null_tokens": [
      "",
      "NULL"
    ],
    "boolean_tokens": {
      "True": true,
      "False": false
    },
    "decode_before_json_schema_validation": true,
    "note": "NULL and empty cells decode to JSON null only in nullable fields. Identifiers such as mukey stay strings. Units=null means not applicable or not separately verified."
  }
}
